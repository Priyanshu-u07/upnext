# Copy to .env. The defaults match docker-compose.yml, so they work as-is for
# local development.

DATABASE_URL="postgresql://queue_user:queue_password@localhost:5432/queue_management?schema=public"

PORT=3001
NODE_ENV=development

# Where the browser runs. Used for CORS and for the Socket.IO handshake.
FRONTEND_URL=http://localhost:5173

# Shared key for the reception dashboard. Staff type this once per machine and
# the browser keeps it; it is never compiled into the frontend bundle.
# Change it before running this anywhere real.
STAFF_KEY=clinic-reception-2026
